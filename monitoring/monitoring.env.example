# Copy to monitoring.env on the box and fill in real values (do NOT commit).
# DB password comes from Secrets Manager (see setup doc step 2).
DATA_SOURCE_NAME=postgresql://petclinic:REPLACE_DB_PASSWORD@REPLACE_RDS_HOST:5432/petclinic?sslmode=require
GF_SECURITY_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
